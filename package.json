{
  "name": "dsh-client-ui-settings-button",
  "version": "0.1.0",
  "description": "Declutters the DSH sidebar: moves the global panel rows (Plugins, Automation tasks, More) and Settings into one popover behind a ⋯ next to the brand mark, and removes the \"Signed in to DeepSeek\" account row.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "src/",
    "docs/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ali-shahabi/dsh-client-ui-settings-button.git"
  },
  "homepage": "https://github.com/ali-shahabi/dsh-client-ui-settings-button#readme",
  "bugs": {
    "url": "https://github.com/ali-shahabi/dsh-client-ui-settings-button/issues"
  },
  "author": {
    "name": "Ali Shahabi",
    "url": "https://github.com/ali-shahabi"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "sidebar",
    "sidebar-menu",
    "navigation",
    "settings",
    "account",
    "ui"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build-client.js",
    "test": "node --test \"tests/*.test.js\"",
    "check": "node scripts/build-client.js --check"
  }
}
